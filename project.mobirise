                        "display": "flex",
                        "align-items": "center",
                        "justify-content": "center",
                        "width": "48px",
                        "height": "48px",
                        "min-width": "48px",
                        "color": "@socColor",
                        "background-color": "@socBg_1",
                        "font-size": "32px",
                        "border-radius": ".5rem",
                        "transition": "all 0.3s ease-in-out",
                        "margin": "0 8px 8px 0"
                      }
