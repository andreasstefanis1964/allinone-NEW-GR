                }
              },
              ".card_1": {
                "background-color": "@card_1",
                "border": "2px solid @card_1"
              },
              ".card_2": {
                "background-color": "@card_2",
                "border": "2px solid @card_2"
              }
            },
            ".mbr-section-title": {
              "color": "#f2c968",
