          "_name": "article03",
          "_sourceTheme": "flexm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article03 flexm5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked=\"\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked=\"\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked=\"\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked=\"\">\n        <input type=\"color\" title=\"Image Overlay Color\" value=\"#f96e47\" name=\"imageOver\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" parallax=\"\" selected=\"\">\n            <input type=\"color\" title=\"Color\" value=\"#F2F2F2\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#F2F2F2\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row items-wrapper\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"card-wrapper\">\n                    <div class=\"image-wrapper\">\n                        <img src=\"@PROJECT_PATH@/assets/images/background4.jpg\" alt=\"Mobirise\">\n                    </div>\n                   <div class=\"content-wrap\">\n                       <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\" data-app-selector=\".mbr-desc\">\n                           Creating and maintaining\n                       </p>\n                       <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                           <b>Website design and development</b>\n                       </h2>\n                       <div class=\"text-wrapper\">\n                           <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                               Crafting visually appealing and user-friendly interfaces. Ensuring the website works well on\n                               various devices, including desktops, tablets, and smartphones.\n                           </p>\n                       </div>\n                       <div mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                           <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                               START NOW\n                           </a>\n                       </div>\n                   </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n",
          "_cid": "ugTWTLQ2cc",
          "_anchor": "article03-7",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".content-wrapper": {
              "margin-bottom": "60px",
              "@media (max-width: 992px)": {
                "margin-bottom": "32px"
              },
              ".mbr-section-title": {
                "margin-bottom": "24px"
              },
              ".mbr-text": {
                "margin-bottom": "0"
              }
            },
            ".tabs-wrapper": {
              "padding-bottom": "24px",
              "border-bottom": "1px solid @border",
              "margin-bottom": "56px",
              "@media (max-width: 992px)": {
                "margin-bottom": "32px"
              },
              ".nav.nav-tabs": {
                "border": "none",
                "padding": "0",
                "border-radius": "0 !important",
                "background-color": "transparent",
                "display": "inline-flex",
                "flex-wrap": "wrap",
                "justify-content": "center",
                ".nav-item": {
                  "padding": "0",
                  "border": "none",
                  "display": "block",
                  "margin": "0 8px 8px",
                  ".nav-link": {
                    "color": "@tabs",
                    "padding": "14px 32px",
                    "margin-bottom": "0",
                    "background-color": "@tabsBg",
                    "border": "none"
                  },
                  ".nav-link.active": {
                    "color": "@active",
                    "background-color": "@activeBg"
                  }
                }
              }
            },
            ".tab-content": {
              ".tab-pane": {
                ".content-wrapper": {
                  "display": "flex",
                  "justify-content": "space-between",
                  "@media (max-width: 992px)": {
                    "display": "block"
                  },
                  ".image-wrapper": {
                    "width": "48%",
                    "@media (max-width: 992px)": {
                      "width": "100%",
                      "margin-bottom": "24px"
                    },
                    "img": {
                      "height": "440px",
                      "object-fit": "cover",
                      "width": "100%",
                      "@media (max-width: 992px)": {
                        "height": "350px"
                      }
                    }
                  },
                  ".text-wrapper": {
                    "width": "48%",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    },
                    ".item-title": {
                      "margin-bottom": "24px"
                    },
                    ".text-wrap": {
                      ".item-text": {
                        "margin-bottom": "0"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-text": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".item-title": {
              "color": "#ffffff"
            },
            ".item-text": {
              "color": "#ffffff"
            }
          },
          "_name": "tabs01",
          "_sourceTheme": "flexm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"tabs01 flexm5\" group=\"List\" plugins=\"mbr-tabs\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked=\"\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked=\"\">\n        <header>Tabs</header>\n        <select title=\"Count\" name=\"bootstrapTabs\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\" selected=\"\">6</option>\n            </select><input type=\"color\" title=\"Tabs Color\" value=\"#b9b9b9\" name=\"tabs\" selected=\"\">\n            <input type=\"color\" title=\"Tabs BG\" value=\"#272b2e\" name=\"tabsBg\" selected=\"\">\n            <input type=\"color\" title=\"Tabs Active Color\" value=\"#ffffff\" name=\"active\" selected=\"\">\n            <input type=\"color\" title=\"Tabs Active BG\" value=\"#f96e47\" name=\"activeBg\" selected=\"\">\n            <input type=\"color\" title=\"Border Color\" value=\"#b9b9b9\" name=\"border\" selected=\"\">\n        \n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\" checked=\"\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" parallax=\"\" selected=\"\">\n            <input type=\"color\" title=\"Color\" value=\"#F2F2F2\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#272b2e\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\" mbr-if=\"showTitle || showText\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .tabs-wrapper\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                        <b>Various approaches</b>\n                    </h2>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n                        Create effective and engaging websites.\n                    </p>\n                </div>\n                <div class=\"tabs-wrapper\">\n                    <ul class=\"nav nav-tabs\" role=\"tablist\">\n                        <li mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"nav-item first mbr-fonts-style\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                            <a class=\"nav-link show active mbr-fonts-style\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab1\" aria-selected=\"true\">\n                                User\n                            </a>\n                        </li>\n                        <li mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 1\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                            <a class=\"nav-link show active mbr-fonts-style\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab2\" aria-selected=\"true\">\n                                Mobile\n                            </a>\n                        </li>\n                        <li mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 2\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                            <a class=\"nav-link show active mbr-fonts-style\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab3\" aria-selected=\"true\">\n                                Responsive\n                            </a>\n                        </li>\n                        <li mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 3\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                            <a class=\"nav-link show active mbr-fonts-style\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab4\" aria-selected=\"true\">\n                                Agile\n                            </a>\n                        </li>\n                        <li mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 4\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                            <a class=\"nav-link show active mbr-fonts-style\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab5\" aria-selected=\"true\">\n                                Content\n                            </a>\n                        </li>\n                        <li mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 5\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                            <a class=\"nav-link show active mbr-fonts-style\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab6\" aria-selected=\"true\">\n                                Minimalist\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div class=\"tab-content\">\n                    <div id=\"tab1\" class=\"tab-pane in active\" role=\"tabpanel\">\n                        <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                            <div class=\"image-wrapper\">\n                                <img src=\"@PROJECT_PATH@/assets/images/image18.jpg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"text-wrapper\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title\">\n                                    <b>User-centered design</b>\n                                </h4>\n                                <div class=\"text-wrap\" mbr-if=\"showText\">\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">\n                                        User-centered design prioritizes the needs, preferences, and behaviors of the\n                                        end-users. This approach involves extensive user research, including surveys,\n                                        interviews, and usability testing, to understand the target audience. The\n                                        insights gained are then used to inform the design process, ensuring the website\n                                        is intuitive, accessible, and user-friendly.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab2\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 1\">\n                        <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                            <div class=\"image-wrapper\">\n                                <img src=\"@PROJECT_PATH@/assets/images/image2.jpg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"text-wrapper\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title\">\n                                    <b>Mobile-first design</b>\n                                </h4>\n                                <div class=\"text-wrap\" mbr-if=\"showText\">\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">\n                                        With the increasing use of mobile devices, many web design agencies adopt a\n                                        mobile-first approach. This strategy involves designing the mobile version of a\n                                        website first, then scaling up for larger screens. This ensures that the site is\n                                        optimized for mobile users, providing a seamless experience on smartphones and\n                                        tablets.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab3\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 2\">\n                        <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                            <div class=\"image-wrapper\">\n                                <img src=\"@PROJECT_PATH@/assets/images/background4.jpg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"text-wrapper\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title\">\n                                    <b>Responsive web design</b>\n                                </h4>\n                                <div class=\"text-wrap\" mbr-if=\"showText\">\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">\n                                        Responsive web design ensures that a website adapts to different screen sizes\n                                        and devices. By using flexible grids, layouts, and images, a responsive design\n                                        provides an optimal viewing experience across a wide range of devices, from\n                                        desktops to mobile phones. This approach is crucial for reaching a diverse\n                                        audience.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab4\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 3\">\n                        <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                            <div class=\"image-wrapper\">\n                                <img src=\"@PROJECT_PATH@/assets/images/image13.jpg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"text-wrapper\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title\">\n                                    <b>Agile development</b>\n                                </h4>\n                                <div class=\"text-wrap\" mbr-if=\"showText\">\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">\n                                        Agile development is a collaborative and iterative approach that emphasizes\n                                        flexibility and customer feedback. Web design agencies using this method work in\n                                        sprints, regularly delivering small updates and enhancements. This allows for\n                                        continuous improvement based on user feedback and changing requirements,\n                                        resulting in a more refined final product.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab5\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 4\">\n                        <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                            <div class=\"image-wrapper\">\n                                <img src=\"@PROJECT_PATH@/assets/images/image4.jpg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"text-wrapper\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title\">\n                                    <b>Content-first design</b>\n                                </h4>\n                                <div class=\"text-wrap\" mbr-if=\"showText\">\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">\n                                        Content-first design focuses on the content as the primary driver of the design\n                                        process. By prioritizing the website’s content early in the design phase,\n                                        agencies ensure that the layout and structure effectively support and highlight\n                                        the message. This approach is particularly useful for content-heavy sites like\n                                        blogs, news sites, and corporate websites.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab6\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 5\">\n                        <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                            <div class=\"image-wrapper\">\n                                <img src=\"@PROJECT_PATH@/assets/images/image24.jpg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"text-wrapper\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title\">\n                                    <b>Minimalist design</b>\n                                </h4>\n                                <div class=\"text-wrap\" mbr-if=\"showText\">\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">\n                                        Minimalist design emphasizes simplicity and clarity, stripping away unnecessary\n                                        elements to focus on essential features and content. This approach creates\n                                        clean, elegant websites that are easy to navigate and fast to load. It’s\n                                        particularly effective for businesses that want to convey a sense of\n                                        sophistication and modernity.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n",
          "_cid": "ugTWXQjfkY",
          "_anchor": "tabs01-a",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".items-wrap": {
              "justify-content": "space-between"
            },
            ".title-wrapper": {
              ".mbr-section-title": {
                "margin-bottom": "60px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "32px"
                }
              }
            },
            ".content-wrapper": {
              "position": "sticky",
              "top": "24px",
              "@media (max-width: 992px)": {
                "position": "static"
              },
              ".mbr-desc": {
                "margin-bottom": "32px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "24px"
                }
              },
              ".mbr-section-subtitle": {
                "border-top": "1px solid @border",
                "padding-top": "32px",
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "padding-top": "24px",
                  "margin-bottom": "24px"
                }
              }
            },
            ".items-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr",
              "gap": "96px 40px",
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".item": {
                "@media (max-width: 992px)": {
                  "margin-bottom": "16px"
                },
                "&:nth-child(2n)": {
                  "padding-top": "315px",
                  "@media (max-width: 992px)": {
                    "padding-top": "0"
                  }
                },
                ".item-wrapper": {
                  ".item-img": {
                    "img": {
                      "height": "650px",
                      "object-fit": "cover",
                      "width": "100%",
                      "@media (max-width: 1200px)": {
                        "height": "350px"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-desc": {
              "color": "#272b2e"
            },
            ".mbr-section-title": {
              "color": "#272b2e"
            },
            ".mbr-section-subtitle": {
              "color": "#272b2e"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#272b2e"
            }
          },
          "_name": "gallery01",
          "_sourceTheme": "flexm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gallery01 flexm5\" group=\"Gallery &amp; Slider\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked=\"\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked=\"\">\n        <input type=\"color\" title=\"Border Color\" value=\"#272b2e\" name=\"border\" condition=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked=\"\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#F2F2F2\" selected=\"\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#F2F2F2\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row items-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12\">\n\t\t\t\t<div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                        <b>We bring visions to life</b>\n                    </h2>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4\">\n                <div class=\"content-wrapper\">\n                    <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\" data-app-selector=\".mbr-desc\">\n                        DELIVER CUSTOMIZED SOLUTIONS\n                    </p>\n                    <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\">\n                        <b>Client's unique needs</b>\n                    </h3>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-7\">\n                <div class=\"items-wrapper\">\n                    <div class=\"item features-image\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-img\">\n                                <img src=\"@PROJECT_PATH@/assets/images/image11.jpg\" alt=\"Mobirise Website Builder\" title=\"\">\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"item features-image\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-img\">\n                                <img src=\"@PROJECT_PATH@/assets/images/image12.jpg\" alt=\"Mobirise Website Builder\" title=\"\">\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n",
