        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "overflow": "hidden",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".title-wrapper": {
              ".mbr-section-title": {
                "margin-bottom": "60px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "32px"
                }
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "354px",
              "max-width": "354px",
              "@media (max-width: 992px)": {
                "min-width": "620px",
                "max-width": "620px"
              },
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  "display": "flex",
                  "align-items": "flex-end",
                  "overflow": "hidden",
                  "position": "relative",
                  "height": "450px",
                  "@media (max-width: 992px)": {
                    "height": "350px"
                  },
                  "&::before": {
                    "content": "''",
                    "position": "absolute",
                    "bottom": "0",
                    "left": "0",
                    "width": "100%",
                    "height": "50%",
                    "background": "linear-gradient(0deg, @card, transparent)",
                    "opacity": ".8",
                    "pointer-events": "none",
                    "z-index": "1"
                  },
                  ".item-img": {
                    "position": "absolute",
                    "top": "0",
                    "left": "0",
                    "width": "100%",
                    "height": "100%",
                    "img": {
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "width": "100%",
                      "height": "100%",
                      "object-fit": "cover",
                      "@media (max-width: 992px)": {
                        "height": "350px"
                      }
                    }
                  },
                  ".item-content": {
                    "position": "relative",
                    "z-index": "1",
                    "padding": "24px",
                    "width": "100%",
                    "@media (max-width: 992px)": {
                      "padding": "20px 16px"
                    },
                    ".item-name": {
                      "margin-bottom": "8px"
                    },
                    ".desc-wrapper": {
                      ".item-tag": {
                        "display": "inline-flex",
                        "align-items": "center",
                        "justify-content": "center",
                        "padding": "2px 12px",
                        "border": "1px solid @desc",
                        "margin": "0"
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "0",
              "width": "40px",
              "height": "40px",
              "font-size": "26px",
              "background": "transparent !important",
              "color": "@arrowsColor !important",
              "border": "none !important",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:hover": {
                "opacity": ".7 !important"
              },
              "&.embla__button--prev": {
                "right": "48px"
              },
              "&.embla__button--next": {
                "right": "0"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "& when (@arrows)": {
                "padding-bottom": "4rem"
              }
            },
            ".embla__viewport": {
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".item-menu-overlay": {
              "opacity": "0 !important"
            },
            ".mbr-section-title": {
              "color": "#272b2e"
            },
            ".item-tag": {
              "color": "#ffffff"
            },
            ".item-name": {
              "color": "#ffffff"
            }
          },
          "_name": "slider03",
          "_sourceTheme": "flexm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider03 mbr-embla flexm5\" group=\"Sliders &amp; Galleries\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked=\"\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"4\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\">\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked=\"\">\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked=\"\">\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked=\"\">\n        <input type=\"color\" title=\"Arrows Color\" value=\"#272b2e\" name=\"arrowsColor\" condition=\"arrows\" selected=\"\">\n        <header>Cards</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"24\" step=\"4\" value=\"12\">\n        <input type=\"checkbox\" title=\"Card Name\" name=\"showName\" checked=\"\">\n        <input type=\"checkbox\" title=\"Card Description\" name=\"showDesc\" checked=\"\">\n        <input type=\"color\" title=\"Description Border Color\" value=\"#ffffff\" name=\"desc\" condition=\"showDesc\">\n        <input type=\"color\" title=\"Card Shadow Color\" value=\"#272b2e\" name=\"card\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\" required=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f2f2f2\" selected=\"\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                        <b>Our team</b>\n                    </h2>\n                </div>\n                <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                    <div class=\"embla__viewport\">\n                        <div class=\"embla__container\">\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/image21.jpg\" alt=\"Mobirise Website Builder\">\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-name mbr-fonts-style\" mbr-if=\"showName\" mbr-theme-style=\"display-4\" data-app-selector=\".item-name, .item-wrap\">\n                                                Michael Wilson\n                                            </p>\n                                            <div class=\"desc-wrapper\">\n                                                <p class=\"item-tag mbr-fonts-style\" mbr-if=\"showDesc\" mbr-theme-style=\"display-4\" data-app-selector=\".item-tag, .desc-wrapper\">\n                                                    UX/UI DESIGNER\n                                                </p>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/image7.jpg\" alt=\"Mobirise Website Builder\">\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-name mbr-fonts-style\" mbr-if=\"showName\" mbr-theme-style=\"display-4\" data-app-selector=\".item-name, .item-wrap\">\n                                                Jane Smith\n                                            </p>\n                                            <div class=\"desc-wrapper\">\n                                                <p class=\"item-tag mbr-fonts-style\" mbr-if=\"showDesc\" mbr-theme-style=\"display-4\" data-app-selector=\".item-tag, .desc-wrapper\">\n                                                    CEO\n                                                </p>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/image26.jpg\" alt=\"Mobirise Website Builder\">\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-name mbr-fonts-style\" mbr-if=\"showName\" mbr-theme-style=\"display-4\" data-app-selector=\".item-name, .item-wrap\">\n                                                John Doe\n                                            </p>\n                                            <div class=\"desc-wrapper\">\n                                                <p class=\"item-tag mbr-fonts-style\" mbr-if=\"showDesc\" mbr-theme-style=\"display-4\" data-app-selector=\".item-tag, .desc-wrapper\">\n                                                    COO\n                                                </p>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/image14.jpg\" alt=\"Mobirise Website Builder\">\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-name mbr-fonts-style\" mbr-if=\"showName\" mbr-theme-style=\"display-4\" data-app-selector=\".item-name, .item-wrap\">\n                                                Laura Kim\n                                            </p>\n                                            <div class=\"desc-wrapper\">\n                                                <p class=\"item-tag mbr-fonts-style\" mbr-if=\"showDesc\" mbr-theme-style=\"display-4\" data-app-selector=\".item-tag, .desc-wrapper\">\n                                                    PROJECT MANAGER\n                                                </p>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/image22.jpg\" alt=\"Mobirise Website Builder\">\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-name mbr-fonts-style\" mbr-if=\"showName\" mbr-theme-style=\"display-4\" data-app-selector=\".item-name, .item-wrap\">\n                                                Jessica Hernandez\n                                            </p>\n                                            <div class=\"desc-wrapper\">\n                                                <p class=\"item-tag mbr-fonts-style\" mbr-if=\"showDesc\" mbr-theme-style=\"display-4\" data-app-selector=\".item-tag, .desc-wrapper\">\n                                                    SEO\n                                                </p>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/image17.jpg\" alt=\"Mobirise Website Builder\">\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-name mbr-fonts-style\" mbr-if=\"showName\" mbr-theme-style=\"display-4\" data-app-selector=\".item-name, .item-wrap\">\n                                                Chris Walker\n                                            </p>\n                                            <div class=\"desc-wrapper\">\n                                                <p class=\"item-tag mbr-fonts-style\" mbr-if=\"showDesc\" mbr-theme-style=\"display-4\" data-app-selector=\".item-tag, .desc-wrapper\">\n                                                    GRAPHIC DESIGNER\n                                                </p>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/image1.jpg\" alt=\"Mobirise Website Builder\">\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-name mbr-fonts-style\" mbr-if=\"showName\" mbr-theme-style=\"display-4\" data-app-selector=\".item-name, .item-wrap\">\n                                                Linda Young\n                                            </p>\n                                            <div class=\"desc-wrapper\">\n                                                <p class=\"item-tag mbr-fonts-style\" mbr-if=\"showDesc\" mbr-theme-style=\"display-4\" data-app-selector=\".item-tag, .desc-wrapper\">\n                                                    QUALITY ASSURANCE\n                                                </p>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <button class=\"embla__button embla__button--prev\">\n                        <span class=\"mobi-mbri mobi-mbri-left mbr-iconfont\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\n                    </button>\n                    <button class=\"embla__button embla__button--next\">\n                        <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n",
          "_cid": "ugTX3dI7IV",
          "_anchor": "slider03-d",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".items-wrap": {
              "justify-content": "center"
            },
            ".content-wrapper": {
              "margin-bottom": "60px",
              "@media (max-width: 992px)": {
                "margin-bottom": "32px"
              },
              ".mbr-section-title": {
                "margin-bottom": "0"
              }
            },
            ".items-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr",
              "gap": "32px",
              "@media (max-width: 992px)": {
                "display": "block"
              }
            },
            ".item": {
              "@media (max-width: 992px)": {
                "margin-bottom": "16px"
              },
              "&:hover, &:focus": {
                ".item-wrapper": {
                  "border": "2px solid @active"
                }
              },
              ".item-wrapper": {
                "display": "flex",
                "flex-direction": "column",
                "justify-content": "space-between",
                "padding": "24px",
                "height": "100%",
                "transition": "all 0.3s ease-in-out",
                "background-color": "@card",
                "border": "2px solid @card",
                "@media (max-width: 1200px)": {
                  "padding": "24px 16px"
                },
                "@media (max-width: 992px)": {
                  "padding": "20px 16px"
                },
                ".card-box": {
                  ".item-title": {
                    "margin-bottom": "10px"
                  },
                  ".item-price": {
                    "margin-bottom": "8px"
                  },
                  ".item-desc": {
                    "margin-bottom": "0",
                    "opacity": ".5"
                  },
                  ".border-wrap": {
                    "height": "1px",
                    "background-color": "@border",
                    "margin-top": "20px"
                  },
                  ".list-wrapper": {
                    "margin-top": "24px",
                    ".list": {
                      "padding": "0",
                      "margin": "0",
                      "list-style-type": "none",
                      ".item-wrap": {
                        "padding-left": "36px",
                        "position": "relative",
                        "margin-bottom": "24px",
                        "@media (max-width: 992px)": {
                          "margin-bottom": "16px"
                        },
                        "&:last-child": {
                          "margin-bottom": "0"
                        },
                        "&::before": {
                          "content": "'✓'",
                          "position": "absolute",
                          "top": "4px",
                          "left": "0",
                          "width": "24px",
                          "height": "24px",
                          "display": "flex",
                          "align-items": "center",
                          "justify-content": "center",
                          "border-radius": "100%",
                          "font-size": "16px"
                        }
                      }
                    },
                    ".list_1 .item-wrap::before": {
                      "color": "@marker_1",
                      "background-color": "lighten(@marker_1, 20%)"
                    },
                    ".list_2 .item-wrap::before": {
                      "color": "@marker_2",
                      "background-color": "lighten(@marker_2, 20%)"
                    },
                    ".list_3 .item-wrap::before": {
                      "color": "@marker_3",
                      "background-color": "lighten(@marker_3, 20%)"
                    }
                  }
                },
                ".mbr-section-btn": {
                  "width": "100%",
                  "margin-top": "22px",
                  "@media (max-width: 992px)": {
                    "margin-top": "16px"
                  },
                  ".btn": {
                    "width": "100%",
                    "padding": "14px"
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#272b2e",
              "text-align": "center"
            },
            ".item-title": {
              "color": "#272b2e",
              "text-align": "center"
            },
            ".item-price": {
              "color": "#000000",
              "text-align": "center"
            },
            ".item-desc": {
              "color": "#272b2e",
              "text-align": "center"
            },
            ".list": {
              "color": "#272b2e"
            }
          },
          "_name": "pricing01",
          "_sourceTheme": "flexm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"pricing01 flexm5\" group=\"Pricing\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Card Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#b9b9b9\" name=\"border\" condition=\"showBorder\" selected>\n        <input type=\"checkbox\" title=\"Card List\" name=\"showList\" checked>\n        <input type=\"color\" title=\"Marker Color 1\" value=\"#7dabab\" name=\"marker_1\" condition=\"showList\" selected>\n        <input type=\"color\" title=\"Marker Color 2\" value=\"#f96e47\" name=\"marker_2\" condition=\"showList\" selected>\n        <input type=\"color\" title=\"Marker Color 3\" value=\"#a672ff\" name=\"marker_3\" condition=\"showList\" selected>\n        <input type=\"checkbox\" title=\"Card Buttons\" name=\"showButtons\" checked>\n        <input type=\"color\" title=\"Active Color\" value=\"#f96e47\" name=\"active\" selected>\n        <input type=\"color\" title=\"Cards BG\" value=\"#ffffff\" name=\"card\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f2f2f2\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#F2F2F2\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row items-wrap\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\" mbr-if=\"showTitle\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                        <b>Our services</b>\n                    </h2>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"items-wrapper\">\n                    <div class=\"item features-without-image\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"card-box\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .icon-wrapper\" mbr-if=\"showCardTitle\">\n                                    Starter package\n                                </h4>\n                                <p class=\"item-price mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-price\">\n                                    <b>$1,500</b>\n                                </p>\n                                <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-desc\" mbr-if=\"showDesc\">\n                                    Monthly payment\n                                </p>\n                                <div class=\"border-wrap\" mbr-if=\"showBorder\"></div>\n                                <div class=\"list-wrapper\" mbr-if=\"showList\">\n                                    <ul class=\"list mbr-fonts-style list_1\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                        <li class=\"item-wrap\">Custom-designed 5-page website</li>\n                                        <li class=\"item-wrap\">Mobile-friendly design</li>\n                                        <li class=\"item-wrap\">Basic SEO optimization</li>\n                                        <li class=\"item-wrap\">Social media integration</li>\n                                        <li class=\"item-wrap\">Contact form setup</li>\n                                        <li class=\"item-wrap\">One round of revisions</li>\n                                        <li class=\"item-wrap\">One month of free maintenance</li>\n                                        <li class=\"item-wrap\">Small businesses and startups</li>\n                                    </ul>\n                                </div>\n                            </div>\n                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\n                                <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                    BUY NOW\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"item features-without-image\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"card-box\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .icon-wrapper\" mbr-if=\"showCardTitle\">\n                                    Business package\n                                </h4>\n                                <p class=\"item-price mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-price\">\n                                    <b>$5,000</b>\n                                </p>\n                                <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-desc\" mbr-if=\"showDesc\">\n                                    Monthly payment\n                                </p>\n                                <div class=\"border-wrap\" mbr-if=\"showBorder\"></div>\n                                <div class=\"list-wrapper\" mbr-if=\"showList\">\n                                    <ul class=\"list mbr-fonts-style list_2\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                        <li class=\"item-wrap\">Custom-designed 15-page website</li>\n                                        <li class=\"item-wrap\">Mobile-responsive design</li>\n                                        <li class=\"item-wrap\">Advanced SEO optimization</li>\n                                        <li class=\"item-wrap\">E-commerce functionality</li>\n                                        <li class=\"item-wrap\">Blog integration</li>\n                                        <li class=\"item-wrap\">Social media integration</li>\n                                        <li class=\"item-wrap\">Contact forms and booking system</li>\n                                        <li class=\"item-wrap\">Three rounds of revisions</li>\n                                    </ul>\n                                </div>\n                            </div>\n                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\n                                <a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                    BUY NOW\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"item features-without-image\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"card-box\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .icon-wrapper\" mbr-if=\"showCardTitle\">\n                                    Premium package\n                                </h4>\n                                <p class=\"item-price mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-price\">\n                                    <b>$10,000</b>\n                                </p>\n                                <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-desc\" mbr-if=\"showDesc\">\n                                    Monthly payment\n                                </p>\n                                <div class=\"border-wrap\" mbr-if=\"showBorder\"></div>\n                                <div class=\"list-wrapper\" mbr-if=\"showList\">\n                                    <ul class=\"list mbr-fonts-style list_3\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                        <li class=\"item-wrap\">Custom-designed unlimited pages</li>\n                                        <li class=\"item-wrap\">Fully mobile-responsive design</li>\n                                        <li class=\"item-wrap\">Comprehensive SEO and analytics</li>\n                                        <li class=\"item-wrap\">Advanced e-commerce functionality </li>\n                                        <li class=\"item-wrap\">Blog integration with advanced</li>\n                                        <li class=\"item-wrap\">Social media integration</li>\n                                        <li class=\"item-wrap\">Custom forms and client portals</li>\n                                        <li class=\"item-wrap\">Five rounds of revisions</li>\n                                    </ul>\n                                </div>\n                            </div>\n                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\n                                <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                    BUY NOW\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "ugTXe8TPqv",
          "_anchor": "pricing01-e",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "overflow": "hidden",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "824px",
              "max-width": "824px",
              "@media (max-width: 992px)": {
                "min-width": "620px",
                "max-width": "620px"
              },
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  "display": "flex",
                  "background-color": "transparent",
                  "@media (max-width: 992px)": {
                    "display": "block"
                  },
                  ".item-img": {
                    "padding-right": "12px",
                    "width": "50%",
                    "@media (max-width: 992px)": {
                      "width": "100%",
                      "margin-bottom": "16px",
                      "padding-right": "0"
                    },
                    "img": {
                      "height": "540px",
                      "object-fit": "cover",
                      "width": "100%",
                      "@media (max-width: 992px)": {
                        "height": "350px"
                      }
                    }
                  },
                  ".item-content": {
                    "display": "flex",
                    "flex-direction": "column",
                    "justify-content": "space-between",
                    "position": "relative",
                    "z-index": "1",
                    "padding": "24px",
                    "width": "50%",
                    "background-color": "@card",
                    "margin-left": "12px",
                    "@media (max-width: 992px)": {
                      "width": "100%",
                      "padding": "20px 16px",
                      "margin-left": "0"
                    },
                    ".item-text": {
                      "margin-bottom": "24px"
                    },
                    ".item-wrap": {
                      ".name-wrapper": {
                        "display": "inline-flex",
                        "align-items": "center",
                        "@media (max-width: 992px)": {
                          "display": "block"
                        },
                        ".icon-wrapper": {
                          "margin-right": "16px",
                          "@media (max-width: 992px)": {
                            "margin-right": "0",
                            "margin-bottom": "16px"
                          },
                          ".mbr-iconfont": {
                            "display": "inline-flex",
                            "font-size": "64px",
                            "min-width": "64px",
                            "color": "@icon"
                          }
                        },
                        ".name-wrap": {
                          ".item-name": {
                            "margin-bottom": "8px"
                          },
                          ".desc-wrapper": {
                            ".item-tag": {
                              "display": "inline-flex",
                              "align-items": "center",
                              "justify-content": "center",
                              "padding": "2px 12px",
                              "background-color": "@desc",
                              "margin": "0"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "0",
              "width": "48px",
              "height": "48px",
              "font-size": "18px",
              "background": "linear-gradient(140deg, @arrowsBg, lighten(@arrowsBg, 20%)) !important",
              "color": "@arrowsColor !important",
              "border": "none !important",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:hover": {
                "opacity": ".9 !important"
              },
              "&.embla__button--prev": {
                "left": "24px",
                "@media (max-width: 992px)": {
                  "left": "16px"
                }
              },
              "&.embla__button--next": {
                "right": "24px",
                "@media (max-width: 992px)": {
                  "right": "16px"
                }
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "& when (@arrows)": {
                "padding-bottom": "4rem"
              }
            },
            ".embla__viewport": {
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".item-menu-overlay": {
              "opacity": "0 !important"
            },
            ".item-text": {
              "color": "#ffffff"
            },
            ".item-tag": {
              "color": "#ffffff"
            },
            ".item-name": {
              "color": "#ffffff"
            }
          },
          "_name": "slider02",
          "_sourceTheme": "flexm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider02 mbr-embla flexm5\" group=\"Sliders &amp; Galleries\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked=\"\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked=\"\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"4\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked=\"\">\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked=\"\">\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\">\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked=\"\">\n        <input type=\"color\" title=\"Arrows Color\" value=\"#ffffff\" name=\"arrowsColor\" condition=\"arrows\" selected=\"\">\n        <input type=\"color\" title=\"Arrows BG\" value=\"#f96e47\" name=\"arrowsBg\" condition=\"arrows\" selected=\"\">\n        <header>Cards</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"24\" step=\"4\" value=\"12\">\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked=\"\">\n        <input type=\"checkbox\" title=\"Card Icon\" name=\"showIcon\" checked=\"\">\n        <input type=\"color\" title=\"Icon Color\" value=\"#ffffff\" name=\"icon\" condition=\"showIcon\">\n        <input type=\"checkbox\" title=\"Card Name\" name=\"showName\" checked=\"\">\n        <input type=\"checkbox\" title=\"Card Description\" name=\"showDesc\" checked=\"\">\n        <input type=\"color\" title=\"Description BG\" value=\"#f96e47\" name=\"desc\" condition=\"showDesc\">\n        <input type=\"color\" title=\"Card BG\" value=\"#272b2e\" name=\"card\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\" required=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#15171a\" selected=\"\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                    <div class=\"embla__viewport\">\n                        <div class=\"embla__container\">\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/image20.jpg\" alt=\"Mobirise Website Builder\">\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">\n                                                \"Working with Web Design Agency has been an outstanding\n                                                experience. Their team brought exceptional creativity.\"\n                                            </p>\n                                            <div class=\"item-wrap\">\n                                                <div class=\"name-wrapper\">\n                                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                                    <span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-user-2 mobi-mbri\"></span>\n                                                    </div>\n                                                    <div class=\"name-wrap\">\n                                                        <p class=\"item-name mbr-fonts-style\" mbr-if=\"showName\" mbr-theme-style=\"display-4\" data-app-selector=\".item-name, .item-wrap\">\n                                                            Sarah Thompson\n                                                        </p>\n                                                        <div class=\"desc-wrapper\">\n                                                            <p class=\"item-tag mbr-fonts-style\" mbr-if=\"showDesc\" mbr-theme-style=\"display-4\" data-app-selector=\".item-tag\">\n                                                                Marketing\n                                                            </p>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/image25.jpg\" alt=\"Mobirise Website Builder\">\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">\n                                                \"We partnered with Web Design Agency for our company’s\n                                                website redesign, and the results have been phenomenal.\"\n                                            </p>\n                                            <div class=\"item-wrap\">\n                                                <div class=\"name-wrapper\">\n                                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                                        <span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-user-2 mobi-mbri\"></span>\n                                                    </div>\n                                                    <div class=\"name-wrap\">\n                                                        <p class=\"item-name mbr-fonts-style\" mbr-if=\"showName\" mbr-theme-style=\"display-4\" data-app-selector=\".item-name, .item-wrap\">\n                                                            Michael Rodriguez\n                                                        </p>\n                                                        <div class=\"desc-wrapper\">\n                                                            <p class=\"item-tag mbr-fonts-style\" mbr-if=\"showDesc\" mbr-theme-style=\"display-4\" data-app-selector=\".item-tag, .desc-wrapper\">\n                                                                CEO\n                                                            </p>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/background2.jpg\" alt=\"Mobirise Website Builder\">\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">\n                                                \"Agency provided innovative solutions that perfectly\n                                                aligned with our brand’s vision. They took the time to understand.\"\n                                            </p>\n                                            <div class=\"item-wrap\">\n                                                <div class=\"name-wrapper\">\n                                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                                        <span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-user-2 mobi-mbri\"></span>\n                                                    </div>\n                                                    <div class=\"name-wrap\">\n                                                        <p class=\"item-name mbr-fonts-style\" mbr-if=\"showName\" mbr-theme-style=\"display-4\" data-app-selector=\".item-name, .item-wrap\">\n                                                            Emily Carter\n                                                        </p>\n                                                        <div class=\"desc-wrapper\">\n                                                            <p class=\"item-tag mbr-fonts-style\" mbr-if=\"showDesc\" mbr-theme-style=\"display-4\" data-app-selector=\".item-tag, .desc-wrapper\">\n                                                                Founder\n                                                            </p>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/image16.jpg\" alt=\"Mobirise Website Builder\">\n                                        </div>\n                                        <div class=\"item-content\">\n                                            <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">\n                                                \"Collaborating with Designs was a transformative experience\n                                                for our company’s digital presence.\"\n                                            </p>\n                                            <div class=\"item-wrap\">\n                                                <div class=\"name-wrapper\">\n                                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                                        <span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-user-2 mobi-mbri\"></span>\n                                                    </div>\n                                                    <div class=\"name-wrap\">\n                                                        <p class=\"item-name mbr-fonts-style\" mbr-if=\"showName\" mbr-theme-style=\"display-4\" data-app-selector=\".item-name, .item-wrap\">\n                                                            David Kim\n                                                        </p>\n                                                        <div class=\"desc-wrapper\">\n                                                            <p class=\"item-tag mbr-fonts-style\" mbr-if=\"showDesc\" mbr-theme-style=\"display-4\" data-app-selector=\".item-tag, .desc-wrapper\">\n                                                                Chief Officer\n                                                            </p>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <button class=\"embla__button embla__button--prev\">\n                        <span class=\"mobi-mbri mobi-mbri-left mbr-iconfont\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\n                    </button>\n                    <button class=\"embla__button embla__button--next\">\n                        <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n",
